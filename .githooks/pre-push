#!/bin/sh
# Tracked forwarder into the guards submodule. A clone without --recursive leaves guards/ empty;
# pointing core.hooksPath straight at guards/hooks would then run nothing and pass in silence.
# So a missing or empty kit hook is a block, never a pass.
_ROOT="$(cd "$(dirname "$0")/.." && pwd)"
_REAL="$_ROOT/guards/hooks/pre-push"
if [ ! -s "$_REAL" ]; then
  echo "BLOCKED: guards/hooks/pre-push is missing or empty, so nothing checked this push." >&2
  echo "  Run: git submodule update --init --recursive" >&2
  exit 1
fi
exec sh "$_REAL" "$@"
